# Salin ke .env (lokal) atau isi di Coolify → Environment Variables. Jangan commit nilai asli.
NODE_ENV=production
PORT=3000
APP_URL=https://iklan.example.com
DATABASE_URL=postgres://iklan:GANTI@iklan-db:5432/iklan
DB_POOL_MAX=5
SESSION_SECRET=                 # 64+ karakter acak: openssl rand -base64 48

# Jalur 1 (disarankan): MCP Meta Ads lewat login Claude Code di VPS. Lihat README "Jalur data Meta".
# Arahkan ke file hasil deploy/export-meta-token.py (hanya berisi token Meta), bukan .credentials.json utuh.
META_MCP_CRED=/run/meta/meta-token.json
META_MCP_URL=https://mcp.facebook.com/ads
META_BRIDGE=auto                # auto | mcp | graph

# Jalur 2 (cadangan): Meta Marketing API, System User token dari Business Manager DNR Media
META_API_VERSION=v24.0
META_APP_SECRET=                # untuk appsecret_proof
META_SYSTEM_USER_TOKEN=
SYNC_INTERVAL_MIN=30
SYNC_ENABLED=true

# lynk.id → Pengaturan webhook: URL https://<domain>/webhooks/lynk, salin merchant key ke sini
LYNK_MERCHANT_KEY=

# Bot AI (kosongkan = bot memakai mode aturan tanpa AI)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CHAT_RATE_PER_HOUR=60
