{
  "name": "@iklan/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/cli/seed-demo.ts",
    "user:create": "tsx --env-file-if-exists=../../.env src/cli/user-create.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@hono/node-server": "^1.13.7",
    "@iklan/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "hono": "^4.6.14",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "embedded-postgres": "17.5.0-beta.15",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
