#!/bin/sh
# Forced command untuk kunci meta-token-push: terima JSON token Meta dari stdin, tulis atomik untuk dashboard.
set -eu
DST=/opt/ads-dashboard/meta-token.json
TMP=$(mktemp /opt/ads-dashboard/.tok-XXXXXX)
trap 'rm -f "$TMP"' EXIT
head -c 65536 > "$TMP"
python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert all(v.get("serverName")=="meta_ads" and v.get("accessToken") for v in d["mcpOAuth"].values())' "$TMP"
chmod 0400 "$TMP"; chown 1000:1000 "$TMP"
mv -f "$TMP" "$DST"
trap - EXIT
echo ok
